# Trade Research settings. Copy to .env and fill in what you use. Never commit .env.
# Restart the backend after changing this file.
#
# Only models whose vendor key is set appear in the model picker. Model names, prices
# and other options are edited in the app under Tools.

# ─────────────────────────────── LLM vendors ───────────────────────────────

# ── Anthropic (Claude) ── https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (GPT) ── https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1        # change for Azure OpenAI or a proxy

# ── Google (Gemini) ── https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Meta (Llama API) ── https://llama.developer.meta.com
LLAMA_API_KEY=
# LLAMA_BASE_URL=https://api.llama.com/compat/v1/

# ── xAI (Grok) ── https://console.x.ai
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1

# ── Mistral ── https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# ── DeepSeek ── https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ──────────────────────────────── Data sources ────────────────────────────────
# Referenced by name from Tools ("Secret environment variable name").

# Connections are managed under Tools > Connections; one connection can serve several data
# sources (e.g. IBKR: real-time quotes, option chains, account, screeners).

# ── SEC EDGAR (free: filings and Form 4 insider trades) ──
# The SEC requires an app name and your contact email in every request, e.g.
# SEC_USER_AGENT=TradeResearch your.name@example.com
SEC_USER_AGENT=

# ── Massive.com, formerly Polygon.io (quotes, bars, option chains, news, off-exchange prints) ──
# Key from https://massive.com/dashboard/keys. What you get depends on your Massive plan.
MASSIVE_API_KEY=
# MASSIVE_BASE_URL=https://api.massive.com

# ── Interactive Brokers via IB Gateway (quotes, bars, option chains, read-only account) ──
# No key: run IB Gateway, log in, and enable API access. Defaults shown.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4002            # IB Gateway: 4002 paper, 4001 live. TWS: 7497 paper, 7496 live.
# IBKR_CLIENT_ID=17
# IBKR_MARKET_DATA_TYPE=3   # 3 = live when subscribed, delayed otherwise; 1 = live only

# ── Interactive Brokers MCP server (optional; only if you run one) ──
IBKR_MCP_TOKEN=

# ── Bigdata.com (MCP server: news, filings, transcripts) ──
BIGDATA_API_KEY=

# ── Add dark pool or other vendors here, then create a Connection that names the variable ──
# EXAMPLE_VENDOR_API_KEY=

# ── Local models (no key; free) ─────────────────────────────────────────────
# Models on local servers are available while the server runs. Add them in Tools → Models → Local models.
# Defaults shown; set only if yours differ.
# OLLAMA_BASE_URL=http://localhost:11434/v1     # Ollama: `ollama serve`, then `ollama pull qwen2.5:14b`
# LMSTUDIO_BASE_URL=http://localhost:1234/v1    # LM Studio: Developer → Start server (runs MLX models on Apple Silicon)
# MLX_BASE_URL=http://localhost:8080/v1         # MLX: `pip install mlx-lm`, then `mlx_lm.server --model <model>`
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1   # any other OpenAI-compatible server (llama.cpp, vLLM…)
# LOCAL_LLM_API_KEY=                            # only if that server wants a key

# ──────────────────────────────── App ────────────────────────────────
# MOCK_LLM=1   # testing: canned answers, no LLM calls or cost (data tools still run). Remove for real use.
# DATABASE_URL=sqlite:///./data/trade_research.db
# CORS_ORIGINS=http://localhost:5173
# MAX_LOOP_ITERATIONS=25
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_MB=20
